/* Rigger app stylesheet.
   Colours never appear as hex here: every rule uses theme tokens
   (see theme.py: rigger-dark / rigger-light).

   Layout for the shell and the pane primitives lives in DEFAULT_CSS on
   those widget classes, so reports/theses/chat still mount standalone.
   This file holds app-level tokens and per-screen trim only. */

/* ---------- shell ---------- */

Screen {
    layout: vertical;
}

/* ---------- pills, dots, hints ---------- */

Pill {
    height: 1;
    margin: 0 1 0 0;
    padding: 0 1;
    background: $panel;
    color: $text-primary;
}

Pill.-ok { color: $text-success; }
Pill.-warn { color: $text-warning; }
Pill.-error { color: $text-error; }
Pill.-dim { color: $text-muted; }

StatusDot {
    width: auto;
    margin: 0 1 0 0;
}

StatusDot.-ok { color: $text-success; }
StatusDot.-warn { color: $text-warning; }
StatusDot.-error { color: $text-error; }

KeyHint {
    width: auto;
    margin: 0 1 0 0;
    padding: 0 1;
    background: $panel;
    color: $text-primary;
    text-style: bold;
}

.empty-hint {
    color: $text-muted;
    margin: 0 0 0 1;
}

.muted {
    color: $text-muted;
}

.check-row {
    height: 1;
    margin: 0 0 1 0;
}

.spark-row {
    height: 3;
    margin: 0 0 1 0;
}

.spark-row Static {
    height: 1;
}

.spark-label {
    width: 8;
    color: $text-muted;
}

.spark-row Sparkline {
    width: 1fr;
    height: 3;
}

.report-row {
    height: 3;
    align-vertical: middle;
}

.report-row Static {
    width: 1fr;
}

/* ---------- tables ---------- */

/* Borderless: the pane frame is the only border.
   Height is deliberately absent — the app stylesheet outranks every screen's
   DEFAULT_CSS regardless of specificity, so setting it here would override
   each screen's own #id sizing. */
DataTable {
    margin: 0;
    background: transparent;
    grid-rows: 1;
}

/* ---------- forms ---------- */

/* One-row inputs: the left bar is the focus ring, so height stays 1. */
Input {
    height: 1;
    padding: 0 1;
    border: none;
    border-left: thick $border-blurred;
    background: $surface;
}

Input:focus {
    border: none;
    border-left: thick $border;
    background: $surface;
}

/* Stock buttons lose the three-row slab; ActionChip is the intended shape. */
Button {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 1;
    margin: 0 1 0 0;
}

Button:focus, Button:hover {
    border: none;
    text-style: bold;
}

/* ---------- panes ---------- */

/* Stacked panes must lose the fixed side-pane widths the screens set. Those
   are #id rules, so !important is what reclaims the full width when a row
   stacks. A screen's min-width has to go the same way: left standing it holds
   a stacked pane wider than the row and overflows it horizontally. */
.pane-row.-narrow > Pane {
    width: 1fr !important;
    min-width: 0 !important;
}

/* ---------- modals ---------- */

/* Every modal is a centred dialog over a dimmed backdrop, with a quiet
   border: the dim is what separates it, not a bright outline. */
ModalScreen {
    align: center middle;
    background: $background 60%;
}

ModalScreen > Vertical {
    padding: 1 2;
    max-height: 90%;
    background: $surface;
    border: solid $border-blurred;
}

#mp-title, #pp-title, #ke-title, #cf-title {
    color: $text-primary;
    text-style: bold;
}

#mp-status, #pp-status, #ke-hint {
    color: $text-muted;
}

#mp-table {
    max-height: 20;
}
