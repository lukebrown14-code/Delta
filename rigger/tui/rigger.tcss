/* Rigger app stylesheet.
   Colours never appear as hex here: every rule uses theme tokens
   (see theme.py: rigger-dark / rigger-light). */

/* ---------- shell ---------- */

Screen {
    layout: vertical;
}

#screen-body {
    height: 1fr;
}

#screen-content {
    padding: 0 1;
}

/* ---------- cards ---------- */

Card {
    height: auto;
    min-height: 5;
    margin: 0 1 1 0;
    padding: 1 2;
    background: $surface;
    border: round $panel;
}

Card.-highlight {
    border: round $primary;
}

CardTitle {
    color: $primary;
    text-style: bold;
    background: transparent;
}

/* ---------- stat tiles ---------- */

StatTile {
    height: 5;
    min-width: 18;
    margin: 0 1 1 0;
    padding: 1 1;
    background: $surface;
    border: round $panel;
}

StatTile Digits {
    color: $primary;
}

StatTile .stat-label {
    color: $text-muted;
}

.stat-row {
    height: auto;
    margin-bottom: 1;
}

/* ---------- pills, dots, hints ---------- */

Pill {
    height: 1;
    margin: 0 1 0 0;
    padding: 0 1;
    background: $panel;
    color: $secondary;
}

Pill.-ok { color: $success; }
Pill.-warn { color: $warning; }
Pill.-error { color: $error; }
Pill.-dim { color: $text-muted; }

StatusDot {
    width: auto;
    margin: 0 1 0 0;
}

StatusDot.-ok { color: $success; }
StatusDot.-warn { color: $warning; }
StatusDot.-error { color: $error; }

KeyHint {
    width: auto;
    margin: 0 1 0 0;
    padding: 0 1;
    background: $panel;
    color: $primary;
    text-style: bold;
}

.empty-hint {
    color: $text-muted;
    margin: 0 0 0 1;
}

.muted {
    color: $text-muted;
}

.check-row {
    height: 1;
    margin: 0 0 1 0;
}

.spark-row {
    height: 3;
    margin: 0 0 1 0;
}

.spark-row Static {
    height: 1;
}

.spark-label {
    width: 8;
    color: $text-muted;
}

.spark-row Sparkline {
    width: 1fr;
    height: 3;
}

.report-row {
    height: 3;
    align-vertical: middle;
}

.report-row Static {
    width: 1fr;
}

/* ---------- tables ---------- */

DataTable {
    height: auto;
    max-height: 20;
    margin: 1 0;
    background: $surface;
    grid-rows: 1;
}

/* ---------- forms ---------- */

Input {
    border: round $panel;
}

Input:focus {
    border: round $primary;
}

Button {
    margin: 0 1 0 0;
}

.tg-form {
    height: auto;
    margin-top: 1;
}

#target-table {
    height: 1fr;
    margin: 1 0;
}

#tg-name, #tg-kind, #tg-market, #tg-tickers, #tg-tags {
    width: 1fr;
    margin: 1;
}

/* ---------- console ---------- */

#console-input {
    margin: 1 0;
}

#console-log {
    height: 1fr;
    margin: 0;
    background: $surface;
    border: round $panel;
}

.console-prompt {
    width: 2;
    color: $primary;
    text-style: bold;
    content-align: center middle;
}

/* ---------- modals ---------- */

/* ---------- kept from the old skin ---------- */

.diagram {
    padding: 1 2;
    color: $text-muted;
}
