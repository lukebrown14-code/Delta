Screen {
    layout: vertical;
}

.title {
    padding: 1 2;
}

.diagram {
    padding: 1 2;
    color: $text-muted;
}

#checks, #targets, #health, #costs, #config {
    padding: 1 2;
}

#console-input {
    margin: 1 2;
}

#console-log {
    height: 1fr;
    margin: 0 2;
}

#target-table {
    height: 1fr;
    margin: 1 2;
}

#tg-name, #tg-kind, #tg-market, #tg-tickers, #tg-tags {
    width: 1fr;
    margin: 1;
}

.modal {
    padding: 2 4;
}
