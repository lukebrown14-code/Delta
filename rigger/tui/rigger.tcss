/* Rigger app stylesheet.
   Colours never appear as hex here: every rule uses theme tokens
   (see theme.py: rigger-dark / rigger-light).

   Layout for the shell and the pane primitives lives in DEFAULT_CSS on
   those widget classes, so reports/theses/chat still mount standalone.
   This file holds app-level tokens and per-screen trim only. */

/* ---------- shell ---------- */

Screen {
    layout: vertical;
}

/* ---------- pills, dots, hints ---------- */

Pill {
    height: 1;
    margin: 0 1 0 0;
    padding: 0 1;
    background: $panel;
    color: $secondary;
}

Pill.-ok { color: $success; }
Pill.-warn { color: $warning; }
Pill.-error { color: $error; }
Pill.-dim { color: $text-muted; }

/* Evidence-kind rows: colour by kind the way theses colours status cells. */
.-kind-news { color: $news; }
.-kind-filing { color: $filing; }
.-kind-bar { color: $price; }
.-kind-event { color: $event; }
.-kind-fundamental { color: $fundamental; }

StatusDot {
    width: auto;
    margin: 0 1 0 0;
}

StatusDot.-ok { color: $success; }
StatusDot.-warn { color: $warning; }
StatusDot.-error { color: $error; }

.empty-hint {
    color: $text-muted;
    margin: 0 0 0 1;
}

.muted {
    color: $text-muted;
}

.check-row {
    height: 1;
    margin: 0 0 1 0;
}

.spark-row {
    height: 3;
    margin: 0 0 1 0;
}

.spark-row Static {
    height: 1;
}

.spark-label {
    width: 8;
    color: $text-muted;
}

.spark-row Sparkline {
    width: 1fr;
    height: 3;
}

.report-row {
    height: 3;
    align-vertical: middle;
}

.report-row Static {
    width: 1fr;
}

/* ---------- tables ---------- */

/* Borderless to match the panes: the winbar above is the only header.
   Height is deliberately absent — the app stylesheet outranks every screen's
   DEFAULT_CSS regardless of specificity, so setting it here would override
   each screen's own #id sizing. */
DataTable {
    margin: 0;
    background: transparent;
    grid-rows: 1;
}

/* Inverted header: the table header is the one filled row, body stays flat. */
DataTable > .datatable--header {
    background: $panel;
    color: $foreground;
    text-style: bold;
}

/* ---------- forms ---------- */

/* One-row left-bar inputs — the ThesisForm treatment, app-wide. */
Input {
    height: 1;
    border: none;
    border-left: thick $panel;
    background: $panel;
    padding: 0 1;
    margin: 0 0 1 0;
}

Input:focus {
    border-left: thick $primary;
}

Select {
    height: 1;
    border: none;
    background: $panel;
    padding: 0 1;
}

Select:focus {
    background: $panel;
}

/* Stock buttons are de-chromed to one row: ActionChip owns the look. */
Button {
    margin: 0 1 0 0;
    border: none;
    height: 1;
    min-width: 0;
    padding: 0 1;
}

/* ---------- panes ---------- */

/* Stacked panes must lose the fixed side-pane widths the screens set. Those
   are #id rules, so !important is what reclaims the full width when a row
   stacks. A screen's min-width has to go the same way: left standing it holds
   a stacked pane wider than the row and overflows it horizontally. */
.pane-row.-narrow > Pane {
    width: 1fr !important;
    min-width: 0 !important;
}

/* ---------- modals ---------- */

/* Every modal is a centred dialog over a dimmed backdrop, with a quiet
   border: the dim is what separates it, not a bright outline. */
ModalScreen {
    align: center middle;
    background: $background 60%;
}

ModalScreen > Vertical {
    padding: 1 2;
    max-height: 90%;
    background: $surface;
    border: round $panel;
}

#mp-title, #pp-title, #ke-title, #cf-title {
    color: $primary;
    text-style: bold;
}

#mp-status, #pp-status, #ke-hint {
    color: $text-muted;
}

#mp-table {
    max-height: 20;
}
