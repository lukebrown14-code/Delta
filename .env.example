# Pick a provider in config.toml ([llm] provider) and set its key here.
# Or skip this file entirely: press p in the app to connect a provider,
# paste the key, and it's saved to .env and activated for you.

# Provider = "openrouter": set OPENROUTER_API_KEY below.
# Provider = "openai": set OPENAI_API_KEY.
# Provider = "anthropic": set ANTHROPIC_API_KEY.
# Provider = "custom": set the variable named by [llm] api_key_env (default CUSTOM_API_KEY).

OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# CUSTOM_API_KEY=

LIVE_TRADING=false
