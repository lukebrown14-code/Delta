# This is a TEMPLATE. Copy it to .env and fill in real values. Never commit
# real secrets here. .env is gitignored; this file is not.

# Provider = "openrouter": set OPENROUTER_API_KEY below.
# Provider = "litellm-proxy": set LITELLM_PROXY_KEY (and point proxy_base_url at your proxy).
# Provider = "litellm" (SDK): LiteLLM reads per-provider keys from the environment
#   (OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY, ...).

OPENROUTER_API_KEY=
LITELLM_PROXY_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

LIVE_TRADING=false
